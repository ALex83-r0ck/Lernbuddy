<StatsScreen>:
    name: "stats"
    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(16)

        MDTopAppBar:
            title: "Statistiken"
            md_bg_color: app.theme_cls.primary_color
            elevation: 2
            left_action_items: [["menu", lambda x: app.toggle_nav_drawer()]]
            right_action_items: [["chart-line", lambda x: None]]
            specific_text_color: 1, 1, 1, 1

        MDLabel:
            text: "Dein Lernfortschritt"
            halign: "center"
            font_style: "H4"
            theme_text_color: "Primary"

        MDCard:
            size_hint_y: None
            height: dp(110)
            padding: dp(16)
            md_bg_color: 0.98, 0.98, 1, 1
            radius: [dp(16)]

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)

                MDLabel:
                    id: total_label
                    text: "Gesamt: 0 Karten"
                    halign: "center"
                    theme_text_color: "Secondary"
                    font_style: "Subtitle1"

                MDProgressBar:
                    id: progress_bar
                    value: 0
                    color: 0, 0.7, 0, 1

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(20)

                    MDLabel:
                        id: progress_label
                        text: "0/0 Karten"
                        halign: "left"
                        theme_text_color: "Secondary"
                        font_style: "Caption"

                    MDLabel:
                        id: progress_percent
                        text: "0.0%"
                        halign: "right"
                        theme_text_color: "Primary"
                        font_style: "Caption"

        MDGridLayout:
            id: stats_container
            cols: 2
            spacing: dp(12)
            size_hint_y: None
            height: self.minimum_height

        MDLabel:
            text: "Letzte Prüfungen"
            halign: "left"
            font_style: "Subtitle1"
            theme_text_color: "Primary"
            size_hint_y: None
            height: dp(40)

        ScrollView:
            size_hint_y: None
            height: dp(180)
            MDBoxLayout:
                id: history_list
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(4)
                padding: dp(8)
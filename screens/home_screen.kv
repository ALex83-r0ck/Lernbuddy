<HomeScreen>:
    MDBoxLayout:
        orientation: "vertical"
        spacing: dp(20)
        padding: dp(20)
        md_bg_color: 1, 1, 1, 1  # Weißer Hintergrund für den BoxLayout
        MDTopAppBar:
            title: "Lernbuddy"
            md_bg_color: 0.0, 0.447, 0.698, 1  # Blaue AppBar
            elevation: 10
            pos_hint: {"top": 1}
            specific_text_color: 1, 1, 1, 1  # Weißer Text
        MDLabel:
            text: "Willkommen!"
            halign: "center"
            theme_text_color: "Custom"
            text_color: 0, 0, 0, 1  # Schwarzer Text
        MDTextField:
            hint_text: "Hier was eingeben"
            size_hint_x: 0.9
            pos_hint: {"center_x": 0.5}
            line_color_normal: 0.0, 0.447, 0.698, 1
            line_color_focus: 0.0, 0.447, 0.698, 1
            text_color_normal: 0, 0, 0, 1
        MDRaisedButton:
            text: "Neue Karte erstellen"
            pos_hint: {"center_x": 0.5}
            md_bg_color: 0.0, 0.447, 0.698, 1
            text_color: 1, 1, 1, 1
            on_release: app.root.current = "eingabe"

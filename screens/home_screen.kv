#:import colors kivymd.color_definitions.colors

<HomeScreen>:
    name: "home"
    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(16)

        MDTopAppBar:
            title: "Lern-Buddy"
            md_bg_color: 0.0, 0.44, 0.6, 1
            elevation: 2
            left_action_items: [["menu", lambda x: app.toggle_nav_drawer()]]
            right_action_items: [["clock-outline", lambda x: None]]
            specific_text_color: 1, 1, 1, 1

        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(50)
            spacing: dp(20)

            MDLabel:
                id: clock_label
                text: "00:00:00"
                font_style: "H5"
                halign: "left"
                theme_text_color: "Primary"

            MDLabel:
                id: motivation_label
                text: ""
                halign: "right"
                font_style: "Caption"
                theme_text_color: "Secondary"
                markup: True  # WICHTIG!

        MDTextField:
            id: search_field
            hint_text: "Frage suchen... (z.B. 'HGB')"
            size_hint_y: None
            height: dp(48)
            mode: "rectangle"
            on_text_validate: root.search_cards(self.text)

        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(80)
            spacing: dp(8)

            MDLabel:
                text: "Gesamtfortschritt"
                font_style: "Subtitle1"
                halign: "center"

            MDProgressBar:
                id: progress_bar
                value: 0
                color: 0, 0.7, 0, 1

            MDLabel:
                id: progress_label
                text: "0/0 Karten"
                halign: "center"
                theme_text_color: "Secondary"

        MDGridLayout:
            cols: 4
            spacing: dp(10)
            size_hint_y: None
            height: dp(60)

            MDCard:
                size_hint: None, None
                size: dp(70), dp(60)
                padding: dp(8)
                md_bg_color: 1, 0.9, 0.9, 1
                MDLabel:
                    text: "Rot"
                    halign: "center"
                    theme_text_color: "Error"
                MDLabel:
                    id: stats_rot
                    text: "0"
                    halign: "center"
                    font_style: "H6"
                    markup: True  # WICHTIG!

            MDCard:
                size_hint: None, None
                size: dp(70), dp(60)
                padding: dp(8)
                md_bg_color: 1, 1, 0.9, 1
                MDLabel:
                    text: "Gelb"
                    halign: "center"
                MDLabel:
                    id: stats_gelb
                    text: "0"
                    halign: "center"
                    font_style: "H6"
                    markup: True

            MDCard:
                size_hint: None, None
                size: dp(70), dp(60)
                padding: dp(8)
                md_bg_color: 0.9, 1, 0.9, 1
                MDLabel:
                    text: "Grün"
                    halign: "center"
                MDLabel:
                    id: stats_grün
                    text: "0"
                    halign: "center"
                    font_style: "H6"
                    markup: True

            MDCard:
                size_hint: None, None
                size: dp(70), dp(60)
                padding: dp(8)
                md_bg_color: 0.95, 0.95, 0.95, 1
                MDLabel:
                    text: "Neu"
                    halign: "center"
                    theme_text_color: "Secondary"
                MDLabel:
                    id: stats_neu
                    text: "0"
                    halign: "center"
                    font_style: "H6"
                    markup: True

        # TIPP DES TAGES
        MDCard:
            size_hint_y: None
            height: dp(100)
            padding: dp(16)
            md_bg_color: 0.98, 0.95, 1, 1
            ripple_behavior: True
            on_release: root.start_weak_quiz()

            MDLabel:
                id: tip_label
                text: ""
                markup: True
                halign: "left"
                size_hint_y: None
                height: dp(50)

            MDLabel:
                id: tip_sub
                text: ""
                theme_text_color: "Secondary"
                size_hint_y: None
                height: dp(20)

        MDGridLayout:
            cols: 2
            spacing: dp(12)
            size_hint_y: None
            height: dp(100)

            MDRaisedButton:
                text: "Quiz starten"
                md_bg_color: 0.0, 0.6, 0.0, 1
                on_release: app.switch_screen("quiz")

            MDRaisedButton:
                text: "Neue Karte"
                md_bg_color: 0.0, 0.44, 0.6, 1
                on_release: app.switch_screen("eingabe")

            MDRaisedButton:
                text: "Tutor fragen"
                md_bg_color: 0.6, 0.0, 0.6, 1
                on_release: app.switch_screen("tutor")

            MDRaisedButton:
                text: "Statistiken"
                md_bg_color: 0.9, 0.6, 0.0, 1
                on_release: app.switch_screen("stats")
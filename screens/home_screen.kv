<HomeScreen>:
    MDBoxLayout:
        orientation: "vertical"
        spacing: dp(20)
        padding: dp(20)
        md_bg_color: [0.4, 0.6, 0.86, 1]  # Static color

        MDTopAppBar:
            title: "Lernbuddy"
            md_bg_color: [0.4, 0.6, 0.86, 1]
            pos_hint: {"top": 1}

        MDTextField:
            hint_text: "Hier was eingeben"
            mode: "outlined"
            size_hint_x: 0.9
            pos_hint: {"center_x": 0.5}

        MDFabButton:
            text: "Neue Karte erstellen"
            pos_hint: {"center_x": 0.5}
            on_release: app.root.current = "eingabe"
<VerwaltungScreen>:
    name: "verwaltung_screen"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)

        MDTopAppBar:
            title: "Kartenverwaltung"
            md_bg_color: app.theme_cls.primary_color
            elevation: 2
            left_action_items: [["menu", lambda x: app.toggle_nav_drawer()]]
            right_action_items: [["cards-outline", lambda x: None]]
            specific_text_color: 1, 1, 1, 1

        MDLabel:
            text: "Alle deine Lernkarten"
            halign: "center"
            font_style: "Subtitle1"
            theme_text_color: "Secondary"
            size_hint_y: None
            height: dp(30)

        ScrollView:
            do_scroll_x: False
            bar_width: dp(4)
            bar_color: app.theme_cls.primary_color
            bar_inactive_color: (0.7, 0.7, 0.7, 0.5)

            MDList:
                id: cards_list
                spacing: dp(4)
                padding: [dp(8), dp(8)]
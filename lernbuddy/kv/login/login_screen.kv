<LoginScreen>:
    name: "login"
    MDBoxLayout:
        orientation: "vertical"
        padding: dp(40)
        spacing: dp(20)

        MDLabel:
            text: "Login zu Lernbuddy"
            font_style: "H4"
            halign: "center"
            theme_text_color: "Primary"

        MDTextField:
            id: username
            hint_text: "Username"
            icon_left: "account"

        MDTextField:
            id: password
            hint_text: "Password"
            password: True
            icon_left: "lock"

        MDBoxLayout:
            orientation: "horizontal"
            spacing: dp(20)

            MDRaisedButton:
                text: "Login"
                on_release: root.login()

            MDRaisedButton:
                text: "Registrieren"
                on_release: root.register()

        MDLabel:
            text: "Guest-Modus: Direkt starten?"
            halign: "center"
            theme_text_color: "Secondary"
            size_hint_y: None
            height: dp(40)

        MDRaisedButton:
            text: "Als Guest starten"
            pos_hint: {"center_x": .5}
            on_release: app.switch_screen("splash")